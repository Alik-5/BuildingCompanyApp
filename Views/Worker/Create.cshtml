@model BuildingCompanyApp.Models.WorkerUpsertViewModel
@{
    ViewData["Title"] = "Add Employee";
    Layout = "_Layout";
}

<section class="page-intro" data-reveal>
    <div>
        <p class="eyebrow">Employee Onboarding</p>
        <h1>Add a new Qore team member and create the login they will use to access their tasks and projects.</h1>
    </div>
</section>

@if (ViewBag.Error != null)
{
    <div class="alert alert-error" data-reveal>@ViewBag.Error</div>
}

<form method="post" action="@Url.Action("Create", "Worker")" class="form-shell" data-reveal>
    <div class="form-section">
        <h2>Employee Profile</h2>
        <div class="form-grid">
            <label><span>Full Name</span><input type="text" name="FullName" class="form-input" value="@Model.FullName" required></label>
            <label><span>Role</span>
                <select name="Role" class="form-select">
                    @foreach (var role in new[] { "Engineer", "Architect", "Worker", "Manager", "Accountant" })
                    {
                        if (role == Model.Role)
                        {
                            <option value="@role" selected>@role</option>
                        }
                        else
                        {
                            <option value="@role">@role</option>
                        }
                    }
                </select>
            </label>
            <label><span>Position</span><input type="text" name="Position" class="form-input" value="@Model.Position" required></label>
            <label><span>Specialization</span><input type="text" name="Specialization" class="form-input" value="@Model.Specialization" required></label>
            <label><span>Salary</span><input type="number" name="Salary" class="form-input" step="0.01" value="@Model.Salary"></label>
            <label><span>Attendance</span>
                <select name="AttendanceStatus" class="form-select">
                    @foreach (var status in new[] { "Present", "On Site", "Remote", "Absent" })
                    {
                        if (status == Model.AttendanceStatus)
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </label>
            <label><span>Work Hours</span><input type="number" name="WorkHours" class="form-input" step="0.5" value="@Model.WorkHours"></label>
            <label><span>Hire Date</span><input type="date" name="HireDate" class="form-input" value="@Model.HireDate.ToString("yyyy-MM-dd")"></label>
            <label><span>Phone</span><input type="tel" name="Phone" class="form-input" value="@Model.Phone"></label>
            <label><span>Address</span><input type="text" name="Address" class="form-input" value="@Model.Address"></label>
        </div>
    </div>

    <div class="form-section">
        <h2>Qore Login Account</h2>
        <div class="form-grid">
            <label><span>Username</span><input type="text" name="Username" class="form-input" value="@Model.Username" required></label>
            <label><span>Email</span><input type="email" name="Email" class="form-input" value="@Model.Email" required></label>
            <label><span>Password</span><input type="text" name="Password" class="form-input" value="@Model.Password" required></label>
            <label><span>System Access</span>
                <select name="AccessRole" class="form-select">
                    @foreach (var role in new[] { "Employee", "Manager" })
                    {
                        if (role == Model.AccessRole)
                        {
                            <option value="@role" selected>@role</option>
                        }
                        else
                        {
                            <option value="@role">@role</option>
                        }
                    }
                </select>
            </label>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Add to Qore</button>
        <a href="@Url.Action("Index", "Worker")" class="btn btn-secondary">Cancel</a>
    </div>
</form>
