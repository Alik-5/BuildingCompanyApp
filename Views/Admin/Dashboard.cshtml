@using BuildingCompanyApp.Models
@model List<User>

@{
    ViewBag.Title = "Admin Dashboard";
    var users = Model ?? new List<User>();
    var activeUsers = users.Where(u => u.IsActive).ToList();
    int adminCount = 0;
    int managerCount = 0;
    int employeeCount = 0;
    
    foreach (var user in activeUsers)
    {
        if (user.Role == "Admin") adminCount++;
        else if (user.Role == "Manager") managerCount++;
        else if (user.Role == "Employee") employeeCount++;
    }
}

<div class="admin-container">
    <div class="admin-header">
        <h1>🛡️ Qore Admin Panel</h1>
        <p class="subtitle">Manage users, roles, and system settings</p>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Success))
    {
        <div class="alert alert-success">
            <strong>Success!</strong> @ViewBag.Success
        </div>
    }

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-danger">
            <strong>Error!</strong> @ViewBag.Error
        </div>
    }

    <div class="admin-actions">
        <a href="@Url.Action("CreateUser", "Admin")" class="btn btn-primary btn-lg">
            <i class="icon">➕</i> Create New User
        </a>
    </div>

    <div class="users-table-card">
        <h2>Active Users</h2>
        <table class="table-responsive">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (users.Count > 0)
                {
                    @foreach (var user in activeUsers)
                    {
                        <tr class="user-row">
                            <td><strong>@user.Username</strong></td>
                            <td>@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="role-badge role-@user.Role.ToLower()">
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="status-badge status-active">Active</span>
                            </td>
                            <td>
                                <a href="@Url.Action("EditUser", "Admin", new { userId = user.UserId })" class="btn-small btn-edit">Edit</a>
                                <form method="post" action="@Url.Action("DeleteUser", "Admin", new { userId = user.UserId })" style="display:inline;">
                                    <button type="submit" class="btn-small btn-danger" onclick="return confirm('Are you sure?')">Deactivate</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">No users found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="admin-stats">
        <div class="stat-card">
            <h3>Total Users</h3>
            <p class="stat-number">@activeUsers.Count</p>
        </div>
        <div class="stat-card">
            <h3>Admins</h3>
            <p class="stat-number">@adminCount</p>
        </div>
        <div class="stat-card">
            <h3>Managers</h3>
            <p class="stat-number">@managerCount</p>
        </div>
        <div class="stat-card">
            <h3>Employees</h3>
            <p class="stat-number">@employeeCount</p>
        </div>
    </div>
</div>

<style>
.admin-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
}

.admin-header {
    text-align: center;
    margin-bottom: 3rem;
    animation: slideInDown 0.6s ease-out;
}

.admin-header h1 {
    font-size: 2.5rem;
    color: #1a2847;
    margin-bottom: 0.5rem;
}

.admin-header .subtitle {
    font-size: 1.1rem;
    color: #666;
}

.alert {
    padding: 1rem;
    border-radius: 0.5rem;
    margin-bottom: 2rem;
    animation: slideInDown 0.4s ease-out;
}

.alert-success {
    background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
    border: 1px solid #b1dfbb;
    color: #155724;
}

.alert-danger {
    background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
    border: 1px solid #f1b0b7;
    color: #721c24;
}

.admin-actions {
    margin-bottom: 2rem;
    display: flex;
    gap: 1rem;
}

.btn-lg {
    padding: 1rem 2rem;
    font-size: 1.1rem;
    border-radius: 0.5rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.btn-primary {
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(79, 70, 229, 0.3);
}

.users-table-card {
    background: white;
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    margin-bottom: 2rem;
    animation: fadeInUp 0.6s ease-out 0.2s both;
}

.users-table-card h2 {
    margin-bottom: 1.5rem;
    color: #1a2847;
}

.table-responsive {
    width: 100%;
    border-collapse: collapse;
}

.table-responsive thead {
    background: #f8f9fa;
    border-bottom: 2px solid #e9ecef;
}

.table-responsive th {
    padding: 1rem;
    text-align: left;
    font-weight: 600;
    color: #495057;
}

.table-responsive td {
    padding: 1rem;
    border-bottom: 1px solid #e9ecef;
}

.user-row:hover {
    background: #f8f9fa;
}

.role-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
}

.role-admin {
    background: #ffe0e0;
    color: #c00;
}

.role-manager {
    background: #e0e7ff;
    color: #4f46e5;
}

.role-employee {
    background: #d1fae5;
    color: #059669;
}

.status-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
}

.status-active {
    background: #d1fae5;
    color: #059669;
}

.btn-small {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-right: 0.5rem;
}

.btn-edit {
    background: #4f46e5;
    color: white;
}

.btn-edit:hover {
    background: #4338ca;
}

.btn-danger {
    background: #ef4444;
    color: white;
}

.btn-danger:hover {
    background: #dc2626;
}

.admin-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
}

.stat-card {
    background: white;
    padding: 1.5rem;
    border-radius: 1rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    text-align: center;
    animation: fadeInUp 0.6s ease-out;
}

.stat-card h3 {
    color: #666;
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
}

.stat-number {
    font-size: 2.5rem;
    font-weight: bold;
    color: #4f46e5;
}

@@keyframes slideInDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
