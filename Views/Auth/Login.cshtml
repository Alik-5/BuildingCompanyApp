@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="auth-screen">
    <div class="auth-backdrop auth-backdrop-one"></div>
    <div class="auth-backdrop auth-backdrop-two"></div>

    <div class="auth-panel" data-reveal>
        <div class="auth-brand">
            <span class="brand-badge">Q</span>
            <div>
                <h1>Qore</h1>
                <p>Construction command center</p>
            </div>
        </div>

        <div class="auth-copy">
            <h2>Welcome back</h2>
            <p>Sign in to manage projects, employees, materials, finance, CRM, documents and tasks.</p>
        </div>

        <form method="post" action="@Url.Action("Login", "Auth")" class="auth-form">
            <label><span>Username</span><input type="text" id="username" name="username" class="form-input" required></label>
            <label><span>Password</span><input type="password" id="password" name="password" class="form-input" required></label>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-error">@ViewBag.Error</div>
            }

            <button type="submit" class="btn btn-primary btn-block">Enter Qore</button>
            <p class="auth-footer">Need an account? <a href="@Url.Action("Register", "Auth")">Create one</a></p>
            @* <p class="auth-hint">Demo: `admin/admin123`, `karen.manager/karen123`, `suren.worker/suren123`</p> *@
        </form>
    </div>
</div>
