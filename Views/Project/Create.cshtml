@model BuildingCompanyApp.Models.ProjectUpsertViewModel
@{
    ViewData["Title"] = "Create Project";
    Layout = "_Layout";
}

<section class="page-intro" data-reveal>
    <div>
        <p class="eyebrow">New Project</p>
        <h1>Open a new project in Qore with stage tracking, client details and assigned team members from day one.</h1>
    </div>
</section>

<form method="post" action="@Url.Action("Create", "Project")" class="form-shell" data-reveal>
    <div class="form-section">
        <h2>Core Information</h2>
        <div class="form-grid">
            <label><span>Project Name</span><input type="text" name="ProjectName" class="form-input" value="@Model.ProjectName" required></label>
            <label><span>Address</span><input type="text" name="Location" class="form-input" value="@Model.Location" required></label>
            <label><span>Client</span><input type="text" name="ClientName" class="form-input" value="@Model.ClientName" required></label>
            <label><span>Deadline</span><input type="date" name="Deadline" class="form-input" value="@Model.Deadline.ToString("yyyy-MM-dd")" required></label>
            <label><span>Start Date</span><input type="date" name="StartDate" class="form-input" value="@Model.StartDate.ToString("yyyy-MM-dd")" required></label>
            <label><span>Budget</span><input type="number" name="Budget" class="form-input" step="0.01" value="@Model.Budget" required></label>
            <label>
                <span>Status</span>
                <select name="Status" class="form-select">
                    @foreach (var status in new[] { "Planning", "In Progress", "On Hold", "Completed", "Cancelled" })
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </label>
            <label>
                <span>Priority</span>
                <select name="Priority" class="form-select">
                    @foreach (var priority in new[] { "Low", "Medium", "High" })
                    {
                        if (priority == Model.Priority)
                        {
                            <option value="@priority" selected>@priority</option>
                        }
                        else
                        {
                            <option value="@priority">@priority</option>
                        }
                    }
                </select>
            </label>
        </div>
    </div>

    <div class="form-section">
        <h2>Stage and Team</h2>
        <div class="form-grid">
            <label>
                <span>Current Stage</span>
                <select name="CurrentStage" class="form-select">
                    @foreach (var stage in new[] { "Foundation", "Walls", "Roof", "Interior", "Finished" })
                    {
                        if (stage == Model.CurrentStage)
                        {
                            <option value="@stage" selected>@stage</option>
                        }
                        else
                        {
                            <option value="@stage">@stage</option>
                        }
                    }
                </select>
            </label>
            <label><span>Stage Progress %</span><input type="number" name="StageCompletionPercent" min="0" max="100" class="form-input" value="@Model.StageCompletionPercent"></label>
            <label><span>Site Manager</span><input type="text" name="SiteManager" class="form-input" value="@Model.SiteManager"></label>
            <label><span>Client Email</span><input type="email" name="ClientEmail" class="form-input" value="@Model.ClientEmail"></label>
            <label><span>Client Phone</span><input type="tel" name="ClientPhone" class="form-input" value="@Model.ClientPhone"></label>
        </div>
        <label><span>Description</span><textarea name="Description" class="form-textarea" required>@Model.Description</textarea></label>

        <div class="selection-block">
            <span class="selection-title">Assigned Team</span>
            <div class="check-grid">
                @for (var i = 0; i < Model.AvailableWorkers.Count; i++)
                {
                    <label class="check-card">
                        @if (Model.AvailableWorkers[i].Selected)
                        {
                            <input type="checkbox" name="SelectedWorkerIds" value="@Model.AvailableWorkers[i].WorkerId" checked>
                        }
                        else
                        {
                            <input type="checkbox" name="SelectedWorkerIds" value="@Model.AvailableWorkers[i].WorkerId">
                        }
                        <span>@Model.AvailableWorkers[i].Label</span>
                    </label>
                }
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save in Qore</button>
        <a href="@Url.Action("Index", "Project")" class="btn btn-secondary">Cancel</a>
    </div>
</form>
