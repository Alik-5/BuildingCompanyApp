@model BuildingCompanyApp.Models.TaskUpsertViewModel
@{
    ViewData["Title"] = "Create Task";
    Layout = "_Layout";
}

<section class="page-intro" data-reveal>
    <div>
        <p class="eyebrow">New Task</p>
        <h1>Create a Qore task and assign it directly to a project employee.</h1>
    </div>
</section>

<form method="post" action="@Url.Action("Create", "Task")" class="form-shell" data-reveal>
    <div class="form-section">
        <div class="form-grid">
            <label><span>Title</span><input type="text" name="Title" class="form-input" value="@Model.Title" required></label>
            <label><span>Project</span>
                <select name="ProjectId" class="form-select" required>
                    <option value="">Select project</option>
                    @foreach (var project in Model.AvailableProjects)
                    {
                        if (project.ProjectId == Model.ProjectId)
                        {
                            <option value="@project.ProjectId" selected>@project.ProjectName</option>
                        }
                        else
                        {
                            <option value="@project.ProjectId">@project.ProjectName</option>
                        }
                    }
                </select>
            </label>
            <label><span>Assign To</span>
                <select name="AssignedWorkerId" class="form-select" required>
                    <option value="">Select employee</option>
                    @foreach (var worker in Model.AvailableWorkers)
                    {
                        if (worker.WorkerId == Model.AssignedWorkerId)
                        {
                            <option value="@worker.WorkerId" selected>@worker.FullName</option>
                        }
                        else
                        {
                            <option value="@worker.WorkerId">@worker.FullName</option>
                        }
                    }
                </select>
            </label>
            <label><span>Priority</span>
                <select name="Priority" class="form-select">
                    @foreach (var priority in new[] { "Low", "Medium", "High" })
                    {
                        if (priority == Model.Priority)
                        {
                            <option value="@priority" selected>@priority</option>
                        }
                        else
                        {
                            <option value="@priority">@priority</option>
                        }
                    }
                </select>
            </label>
            <label><span>Status</span><input type="text" name="Status" class="form-input" value="@Model.Status"></label>
            <label><span>Progress %</span><input type="number" name="ProgressPercent" min="0" max="100" class="form-input" value="@Model.ProgressPercent"></label>
            <label><span>Comments</span><input type="number" name="CommentCount" class="form-input" value="@Model.CommentCount"></label>
            <label><span>Due Date</span><input type="date" name="DueDate" class="form-input" value="@Model.DueDate.ToString("yyyy-MM-dd")"></label>
        </div>
        <label class="checkbox-line">
            @if (Model.NotificationsEnabled)
            {
                <input type="checkbox" name="NotificationsEnabled" value="true" checked>
            }
            else
            {
                <input type="checkbox" name="NotificationsEnabled" value="true">
            }
            <span>Enable notifications</span>
        </label>
        <label><span>Latest Comment</span><input type="text" name="LatestComment" class="form-input" value="@Model.LatestComment"></label>
        <label><span>Description</span><textarea name="Description" class="form-textarea">@Model.Description</textarea></label>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create Task</button>
        <a href="@Url.Action("Index", "Task")" class="btn btn-secondary">Cancel</a>
    </div>
</form>
