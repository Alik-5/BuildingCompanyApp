@model List<BuildingCompanyApp.Models.Client>
@{
    ViewData["Title"] = "Qore Clients";
    Layout = "_Layout";
}

<section class="page-intro" data-reveal>
    <div>
        <p class="eyebrow">Client Management</p>
        <h1>Track contracts, notes, history and reminders in the Qore CRM.</h1>
    </div>
    <a href="@Url.Action("Create", "Client")" class="btn btn-primary">Add Client</a>
</section>

<section class="card-grid two-up">
    @foreach (var client in Model)
    {
        <article class="module-card" data-reveal>
            <div class="module-card-body">
                <div class="stack-title-row">
                    <h2>@client.Name</h2>
                    <span class="status-chip">@client.ContractStatus</span>
                </div>
                <p class="muted">@client.CompanyName</p>
                <div class="fact-list tight">
                    <div><span>Email</span><strong>@client.Email</strong></div>
                    <div><span>Phone</span><strong>@client.Phone</strong></div>
                    <div><span>Reminder</span><strong>@client.ReminderDate.ToString("MMM dd, yyyy")</strong></div>
                    <div><span>Project History</span><strong>@client.ProjectHistory</strong></div>
                </div>
                <p>@client.Notes</p>
            </div>
        </article>
    }
</section>
