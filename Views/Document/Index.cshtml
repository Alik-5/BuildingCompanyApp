@model BuildingCompanyApp.Models.DocumentHubViewModel
@{
    ViewData["Title"] = "Qore Documents";
    Layout = "_Layout";
}

<section class="page-intro" data-reveal>
    <div>
        <p class="eyebrow">Document Management</p>
        <h1>Keep contracts, blueprints, permits, PDFs and site images searchable in Qore.</h1>
    </div>
    <a href="@Url.Action("Upload", "Document")" class="btn btn-primary">Upload Document</a>
</section>

<section class="dashboard-grid">
    <article class="panel-card" data-reveal>
        <div class="panel-header">
            <div>
                <p class="eyebrow">Coverage</p>
                <h2>Library summary</h2>
            </div>
        </div>
        <div class="fact-list">
            <div><span>Total Files</span><strong>@Model.Documents.Count</strong></div>
            <div><span>Projects Linked</span><strong>@Model.Projects.Count(project => Model.Documents.Any(doc => doc.ProjectId == project.ProjectId))</strong></div>
            <div><span>Worker Records</span><strong>@Model.Workers.Count(worker => Model.Documents.Any(doc => doc.WorkerId == worker.WorkerId))</strong></div>
        </div>
    </article>

    <article class="panel-card span-two" data-reveal>
        <div class="panel-header">
            <div>
                <p class="eyebrow">Repository</p>
                <h2>Attached files</h2>
            </div>
        </div>
        <div class="mini-table">
            @foreach (var doc in Model.Documents)
            {
                <div class="mini-row">
                    <div>
                        <strong>@doc.DocumentName</strong>
                        <p>@doc.Category @(doc.Project != null ? $" / {doc.Project.ProjectName}" : string.Empty)</p>
                    </div>
                    <div class="mini-row-right">
                        <span class="pill">@doc.DocumentType</span>
                        <strong>@doc.UploadedDate.ToString("MMM dd, yyyy")</strong>
                    </div>
                    <div class="row-actions">
                        @if (!string.IsNullOrWhiteSpace(doc.DocumentPath) && doc.DocumentPath != "#")
                        {
                            <a href="@doc.DocumentPath" download class="btn btn-secondary">Download</a>
                        }
                        <form method="post" action="@Url.Action("Delete", "Document", new { id = doc.DocumentId })">
                            <button type="submit" class="btn btn-danger" onclick="return confirmDelete('Delete this document from Qore?')">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </article>
</section>
